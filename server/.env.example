# ── Server ──────────────────────────────────────────────
NODE_ENV=development
PORT=5000
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000,https://www.4lancers.com,https://4lancers.com
# Number of proxies in front of the app (Nginx / load balancer) — needed for correct IP rate limiting
TRUST_PROXY=1

# ── Database ────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/4lancers

# ── Admin API (lead management) ─────────────────────────
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=change-me-to-a-long-random-string-000000

# ── Email notifications (optional — leads are still saved without it) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="4lancers Website <no-reply@4lancers.com>"
LEAD_NOTIFY_TO=hello@4lancers.com

# ── Single-server deploy: serve the built website from Express ──
SERVE_CLIENT=false
CLIENT_DIST=../client/dist/client

# ⚠️ Secrets (MongoDB, SMTP, REACTBITS_LICENSE_KEY…) live ONLY in server env — never commit .env
