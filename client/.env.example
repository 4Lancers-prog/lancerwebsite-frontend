npm run dev:server# Public (exposed to browser) — Vike exposes only PUBLIC_ENV__* variables
PUBLIC_ENV__SITE_URL=https://www.4lancers.com
# Leave as /api when the API is served on the same domain (recommended, via Nginx or Express)
PUBLIC_ENV__API_URL=/api

# Dev only: where the Vite dev server proxies /api
API_PROXY_TARGET=http://localhost:5000

# ⚠️ Never put REACTBITS_LICENSE_KEY or any server secret here with a PUBLIC_ENV__ prefix.
